# Schede in lavorazione: spazio locale, mai in repo. Sono gia' escluse dai
# controlli e dalla build, ma restavano visibili a git come non tracciate, e
# un `git add -A` le avrebbe messe in stage in blocco (cfr. incidente
# Bonaiuto). Si spostano in Content/ alla pubblicazione, non si committano.
drafts/

# Destinazione locale del backup completo (scripts/backup_to_volume.sh).
.backup_path

# Permessi e corrispondenza sui diritti delle immagini: mai nel repository (pubblico)
*PERMESSO*

# Zoom ad alta risoluzione: vivono qui in locale e su R2 (bucket mindatabase-zoom,
# https://zoom.medievalvisions.com), non nel repository. Il backup su Prog li
# copia; scripts/sync_zoom_r2.sh li carica e aggiorna assets/data/zoom-manifest.json.
Zoom/
