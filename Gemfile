source "https://rubygems.org"

# github-pages fissa Jekyll e i plugin esattamente alle versioni
# usate da GitHub Pages in produzione. Non specificare 'jekyll'
# separatamente: la versione la decide questa gem.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Con Ruby 3 webrick non e' piu' incluso di default e serve a jekyll serve.
gem "webrick", "~> 1.8"
